{
  "name": "larpedin",
  "version": "1.0.0",
  "description": "LarpedIn: solves LinkedIn's daily puzzle games in the browser. Not affiliated with LinkedIn.",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc",
    "bench": "node scripts/bench-zip.ts",
    "bench:tango": "node scripts/bench-tango.ts",
    "bench:queens": "node scripts/bench-queens.ts",
    "bench:patches": "node scripts/bench-patches.ts",
    "bench:wend": "node scripts/bench-wend.ts",
    "dict:wend": "node scripts/make-wend-dict.mjs",
    "site:build": "node scripts/package-site.mjs",
    "site:serve": "node site/dev/serve.mjs",
    "site:shots": "node site/dev/screenshots.mjs",
    "site:og": "node site/dev/render-og.mjs",
    "icons": "node scripts/icons.ts",
    "screenshots": "node scripts/build.mjs && node scripts/screenshots.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "an-array-of-english-words": "^2.0.0",
    "esbuild": "^0.25.10",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "wordlist-english": "^1.2.1"
  },
  "type": "module"
}
